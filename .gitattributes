# =============================================================
# MediTurnos — normalización de fin de línea
# =============================================================
# El proyecto se desarrolla en Windows (XAMPP) pero puede clonarse
# en Linux o macOS. Sin esta configuración, Git guardaría los saltos
# de línea de Windows (CRLF) dentro del repositorio y cualquier
# cambio mínimo aparecería como "archivo entero modificado" al
# trabajar desde otro sistema.
#
# Con `text=auto`, Git guarda SIEMPRE con LF en el repositorio y
# convierte al formato local en cada checkout.
* text=auto

# Archivos de código: LF explícito
*.php  text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.txt  text eol=lf

# Los guiones de shell necesitan LF o no arrancan: con CRLF, el `\r`
# queda pegado al final de la línea del shebang y el sistema busca un
# intérprete llamado "bash\r", que no existe. Sin esta línea, Git los
# convertía a CRLF en cada checkout bajo Windows.
*.sh   text eol=lf

# .htaccess va a un servidor Linux. Con CRLF, el retorno de carro queda
# pegado al final del valor de cada directiva: un DirectoryIndex así
# apunta a un archivo que no existe, y un Header set manda la cabecera
# con un carácter de más.
.htaccess text eol=lf

# Los .bat de Windows necesitan CRLF sí o sí
*.bat  text eol=crlf

# Binarios: Git no debe tocarlos
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
